# ============================================================
# QTL_Bot 強震モニタ（Kyoshin）アルゴリズム調整値
# ============================================================
#
# 【このファイルについて】
# .env.example（本体設定）から、強震モニタ画像解析検知の「誤検知
# 対策アルゴリズム調整値」6個だけを分離した、上級者向けのオプション
# ファイルです（.env整理案③・⑩、2026-08-27）。
#
# ★ 通常運用ではこのファイルは不要です ★
# 本体の .env にこのファイルの変数を1つも書かなくても、以下に書かれて
# いるのと同じデフォルト値で強震モニタは正常に動作します。実機の
# ログを見ながら「誤検知が多い／逆に検知が甘い」といった調整をしたい
# 場合にだけ、このファイルをコピーして使ってください。
#
# 【使い方】
#   cp .env.kyoshin.example .env.kyoshin
#   nano .env.kyoshin   # 調整したい値だけ変更する
#
# ファイル名は固定で ".env.kyoshin"（拡張子ではなく、.env の後ろに
# ".kyoshin" が付く形）です。bot.py 起動時に .env 本体を読み込んだ
# 後、このファイルが存在すれば自動的に追加読み込みされます
# （core/env_loader.py 参照）。.env 本体に同じ変数名を書いた場合は
# そちらが優先されるため、書き間違いで事故になることはありません。
#
# ============================================================

# 【2026-07-22 検知アルゴリズムの方針転換】
# 当初は「HSVマスクで抽出したアクティブセルを8近傍で連結成分化し、
# 最小サイズ以上・複数フレーム持続で確定させる」(ClusterTracker)方式
# だったが、震度の絶対値が静的に隣接しているかしか見ておらず、
# 単一観測点由来のGIF圧縮ノイズが偶然2〜3セルにまたがるだけで
# 誤検知に至るケースが多発した。
# ingen084氏の記事(https://qiita.com/ingen084/items/82985e8d3227c97c608d)
# が提唱する「観測点ごとの震度の時系列上昇幅を追跡し、近隣観測点も
# 同時に上昇しているか」という動的な変化ベースの判定に切り替えた。

# HSVマスク処理で「揺れ候補ピクセル」とみなす実震度の下限値。
# これ未満の実震度に相当する色（背景の青〜水色域）は解析対象に含めない。
# 検知アルゴリズムを時系列上昇幅ベースに切り替えたため、この閾値は
# あくまで「明らかに揺れていない色を除外する一次フィルタ」としての
# 役割に限定される（誤検知対策の主眼はKYOSHIN_RISE_THRESHOLDと
# KYOSHIN_NEIGHBOR_TRIGGER_COUNTに移した）。0.5より下げると単一観測点の
# GIF圧縮ノイズまで解析対象に含まれ誤検知の原因になることが確認されている。
# デフォルト: 0.5
KYOSHIN_ACTIVE_SHINDO_FLOOR=0.5

# 「上昇トリガー」とみなす実震度の上昇幅（基準値との差分）。
# ingen084氏の記事の核心となるパラメータ。単一観測点の震度がこの幅
# 以上急上昇した場合にのみ「候補」として扱う（絶対値ではなく変化量を
# 見ることで、常に薄く色が乗っているセルなどの静的ノイズを自然に
# 除外できる）。震度の絶対値による無条件の救済判定は行わない
# （震度が高止まりし続ける限り真であり続けてしまい、「検知が終わらない
# バグ」の直接原因になるため意図的に排除している）。
# 【2026-08 一時的な引き上げ】実観測点1ピクセルのみをサンプリングする
# 方式（平滑化なし）に移行した結果、旧・グリッド方式（N×N平均で
# 平滑化済み）向けに調整されていた0.5では誤検知が多発した。
# 恒久対策（パッチサンプリングでの平滑化）を検討するまでの一時的な
# 緩和措置として1.0に引き上げる。
# デフォルト: 1.0
KYOSHIN_RISE_THRESHOLD=1.0

# 基準値(baseline)は「N秒前ちょうどの1点」ではなく「範囲内サンプルの
# 平均」で計算する。参考実装(p_s(14).html)が採用するbaselineAvg方式に
# 準拠。基準値がノイズ1点に左右されにくくなる。
# 直近すぎる範囲(0〜KYOSHIN_BASELINE_WINDOW_START_SEC秒前)は基準値の
# 計算に含めない（ゆっくり立ち上がる揺れ自体を基準値に混入させないため）。
# デフォルト: 10.0（秒）
KYOSHIN_BASELINE_WINDOW_START_SEC=10.0
# デフォルト: 25.0（秒）
KYOSHIN_BASELINE_WINDOW_END_SEC=25.0

# 観測点ごとに保持する震度履歴の長さ（秒）。KYOSHIN_BASELINE_WINDOW_END_SEC
# より短くすると基準値の計算に必要なサンプルが欠落するため、通常は
# BASELINE_WINDOW_END_SECと同じか、それ以上の値にすること。
# デフォルト: 25.0（秒）
KYOSHIN_HISTORY_WINDOW_SEC=25.0

# 【2026-09-06 追加】起動直後のウォームアップ期間（秒）。
# 起動直後は観測点のhistoryが浅く、基準値(baseline)がKYOSHIN_BASELINE_
# WINDOW_END_SEC秒分の実サンプル平均ではなく「履歴中の最古の1点」への
# フォールバックにならざるを得ない。これを避けるため、起動からこの秒数が
# 経過し基準値計算に十分な履歴が貯まるまでは、揺れ検知イベントの新規
# 生成・確定を抑制する（観測点の震度履歴の蓄積＝ingest自体は起動直後
# から通常通り継続する）。
# 未設定時はKYOSHIN_BASELINE_WINDOW_END_SECと同じ値が使われる。
# 固定秒数で上書きしたい場合のみ設定する。0以下でウォームアップ無効化
# （従来通り起動直後から検知を行う）。
# デフォルト: KYOSHIN_BASELINE_WINDOW_END_SEC の値（未設定なら25.0秒）
KYOSHIN_STARTUP_WARMUP_SEC=25.0

# 上昇トリガーが立った観測点について、K近傍（本体.envのKYOSHIN_NEIGHBOR_K）
# の観測点のうち何点が「同時に」上昇トリガーを満たしていれば本物の
# 揺れとみなすか。ingen084氏の記事における「周囲の観測点も上昇して
# いた場合、揺れている、という判定を行う」の実装部分。値を上げるほど、
# より広範囲で同時多発的な上昇でないと確定しなくなり、誤検知に対して
# 厳しくなる（その分、検知の即応性・感度は下がる）。
# 小規模地震(M2・最大震度1)で単一観測点しか反応しないケースは検知漏れに
# なるが、これを下げると単一観測点ノイズとの区別が事実上付かなくなり
# 誤検知が再発するため、通常時は低めの値を維持する方針だった。
# 【2026-08 一時的な引き上げ】実観測点のK近傍は都市部を中心に画像上で
# 数ピクセルしか離れていないケースが多く（K近傍ペアの過半数が4〜6px
# 以内）、強震モニタ画像の空間補間により近接ピクセルの色ノイズが
# 相関しやすいため、「2点一致」では単一ノイズ源が複数の近隣を同時に
# 「上昇」させる誤検知が多発した。恒久対策を検討するまでの一時的な
# 緩和措置として、K=6中3点（過半数）に引き上げる。
# デフォルト: 3（点）
KYOSHIN_NEIGHBOR_TRIGGER_COUNT=3
