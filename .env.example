# ============================================================
# QTL_Bot 環境変数設定ファイル（.env.example）
# ============================================================
#
# 使い方（お好きな方法で）:
#
#   方法A: 対話式セットアップウィザード（初めての場合はこちらを推奨）
#     python3 bot.py --starter
#     Bot トークン・チャンネル ID 等、最低限の項目だけ質問されます。
#     詳細設定（強震モニタ・Web Dashboard・USGS等）に進むかどうかも
#     途中で選べます。それ以外はこのファイルのデフォルト値のまま
#     .env に反映されます。
#
#   方法B: このファイルを手動でコピー
#     cp .env.example .env
#     nano .env
#
# 各行の意味・デフォルト値・単位はコメントを参照してください。
# 「（必須）」の付いた項目は未設定だと Bot が起動時にエラー終了します。
#
# 【関連ファイル】
# 強震モニタ（Kyoshin）の誤検知対策アルゴリズム調整値6個は、実機ログ
# を見ながらチューニングする上級者向けパラメータのため、このファイル
# には含まれていません（通常運用では触る必要がないため）。調整したい
# 場合のみ .env.kyoshin.example を参照してください
# （cp .env.kyoshin.example .env.kyoshin）。
#
# 【設定内容の整合性チェック】
# このファイルとコード内の実際の参照箇所（os.getenv 呼び出し等）が
# 食い違っていないかを機械的に確認したい場合は、以下を実行してください:
#     python3 bot.py --check_env
#
# ------------------------------------------------------------
# 目次（Ctrl+W 等でセクション名を検索するとジャンプできます）
# ------------------------------------------------------------
#   1. Discord 基本設定
#   2. 通知先チャンネル設定（上書き・後方互換あり）
#   3. ログ設定
#   4. 地震情報 通知フィルター
#   5. 地震情報 種別ごとの有効化フラグ
#   6. EWS（緊急警報放送）信号音
#   7. USGS 海外地震情報設定
#   8. リソース監視設定
#   9. 強震モニタ画像解析（Kyoshin）設定（誤検知対策の詳細調整値は
#      .env.kyoshin.example に分離）
#  10. 音声設定（AquesTalkPi / ScratchTTS）
#  11. EEW・API 挙動設定
#  12. キュー設定（メモリ枯渇対策）
#  13. !status / /qtl_status 表示設定
#  14. Mackerel APM（トレーシング）連携設定
#  15. Web Dashboard 設定
#  16. P2P 地図画像設定
#  17. P2P 地震感知情報設定
#  18. 週間/月間ダイジェスト設定
# ------------------------------------------------------------

# ------------------------------------------------------------
# ■ 1. Discord 基本設定
# ------------------------------------------------------------

# Discord Bot のトークン（必須）
BOT_TOKEN=your_discord_bot_token_here

# デフォルト通知先チャンネル ID（必須）。
# 他の *_CHANNEL_ID が未設定の場合、すべての通知はこのチャンネルに送られる。
CHANNEL_ID=your_channel_id_here


# ------------------------------------------------------------
# ■ 2. 通知先チャンネル設定（上書き・後方互換あり）
# ------------------------------------------------------------
# 各変数は「未設定なら親の設定にフォールバックする」多段構成になっている。
# 例: KYOSHIN_CHANNEL_ID 未設定 → OTHER_CHANNEL_ID 未設定 → CHANNEL_ID を使用
# ※ 値を空のままにしても正しくフォールバックする（core/config.py側で対策済み）。

# EEW（緊急地震速報）専用チャンネル（未設定時: CHANNEL_ID）
EEW_CHANNEL_ID=

# P2P地震情報からのEEW専用チャンネル（未設定時: EEW_CHANNEL_ID → CHANNEL_ID）
P2P_EEW_CHANNEL_ID=

# 地震情報専用チャンネル（未設定時: CHANNEL_ID）
QUAKE_CHANNEL_ID=

# 津波警報専用チャンネル（未設定時: CHANNEL_ID）
TSUNAMI_CHANNEL_ID=

# その他情報（長周期地震動・気象庁その他情報等）専用チャンネル（未設定時: CHANNEL_ID）
OTHER_CHANNEL_ID=

# 火山情報専用チャンネル（未設定時: CHANNEL_ID）
VOLCANO_CHANNEL_ID=

# 強震モニタ（画像解析検知）専用チャンネル（未設定時: OTHER_CHANNEL_ID → CHANNEL_ID）
KYOSHIN_CHANNEL_ID=

# USGS海外地震情報専用チャンネル（未設定時: QUAKE_CHANNEL_ID → CHANNEL_ID）
USGS_CHANNEL_ID=

# 地震感知情報専用チャンネル（未設定時: QUAKE_CHANNEL_ID → CHANNEL_ID）
JISHIN_KANCHI_CHANNEL_ID=

# エラー通知を受け取る管理者チャンネル ID（未設定=0の場合、エラー自動通知機能は無効）
ADMIN_CHANNEL_ID=


# ------------------------------------------------------------
# ■ 3. ログ設定
# ------------------------------------------------------------

# ログレベル（DEBUG / INFO / WARNING / ERROR / CRITICAL）。
# LOG_LEVEL_FILE / LOG_LEVEL_CONSOLE 未設定時の共通デフォルト値として使われる。
# デフォルト: INFO　推奨: 本番運用は INFO、調査時のみ一時的に DEBUG
LOG_LEVEL=INFO

# ファイル出力専用のログレベル（未設定時: LOG_LEVEL を使用）
LOG_LEVEL_FILE=INFO

# コンソール出力専用のログレベル（未設定時: LOG_LEVEL を使用）
LOG_LEVEL_CONSOLE=INFO

# ログファイルの最大サイズ（バイト）。超過するとローテーションされる。
# デフォルト: 10485760（10MB）
LOG_MAX_BYTES=10485760

# ログローテーションで保持する世代数（qtlbot.log.1 〜 .N）
# デフォルト: 7
LOG_BACKUP_COUNT=7

# ログファイルの出力先パス。
# 【2026-08-29 追加】未設定時は「プロジェクトルート/qtlbot.log」
# （bot.py と同じディレクトリ）が使われる。これはBot起動時の
# カレントディレクトリに依存しない絶対パスであり、通常は変更不要。
# systemdサービス化等で /var/log 配下等、別の場所にログを出力したい
# 場合のみ、ここに絶対パスを指定する（相対パスも指定可能だが、
# その場合は起動時のカレントディレクトリ次第で場所が変わる点に注意）。
# 例: LOG_FILE_PATH=/var/log/qtlbot/qtlbot.log
LOG_FILE_PATH=

# 同一メッセージの重複出力を抑制する秒数。ERROR以上のログは常に出力される。
# デフォルト: 60（秒）
LOG_DUPLICATE_THRESHOLD=60

# aiohttp.access の 2xx（成功）ログを抑制するか。
# Web Dashboardを定期ポーリングする運用ではディスク書き込み削減のため true 推奨。
# デフォルト: true
LOG_SUPPRESS_HTTP_SUCCESS=true


# ------------------------------------------------------------
# ■ 4. 地震情報 通知フィルター
# ------------------------------------------------------------

# 通知する最低震度（0=全て / 10=震度1以上 / 30=震度3以上 / 50=震度5弱以上）
# デフォルト: 0
QUAKE_MIN_SCALE=0

# 通知する最低マグニチュード
# デフォルト: 0.0
QUAKE_MIN_MAG=0.0

# 震源の深さ下限（km）。これより浅い地震は通知しない。
# デフォルト: 0
QUAKE_MIN_DEPTH=0

# 震源の深さ上限（km）。これより深い地震は通知しない。
# デフォルト: 9999
QUAKE_MAX_DEPTH=9999

# EEW通知の最低震度（INT_MAPの数値キー。0=全て通知）
# デフォルト: 0
EEW_MIN_INTENSITY=0

# 各地の震度に関する情報で、最大震度より1階級小さい震度を観測した
# 観測点数がこの件数以上の場合、都道府県ごとに1地点だけを代表として
# 表示し「（以下略）」を付けて省略する（通知文の肥大化防止）。
# デフォルト: 10
QUAKE_INTENSITY_COLLAPSE_THRESHOLD=10

# 緊急地震速報（EEW）で、警報対象の府県予報区数（region_map.json変換後）
# がこの件数以上の場合、pref_region_map.json で地方予報区へ集約して
# 通知・読み上げる（例:「北海道道南,北海道道央,...,千葉」14件
# → 「北海道,東北,関東」）。
# デフォルト: 10
EEW_REGION_COLLAPSE_THRESHOLD=10


# ------------------------------------------------------------
# ■ 5. 地震情報 種別ごとの有効化フラグ
# ------------------------------------------------------------

# P2P地震情報の各情報種別ごとの通知有効化フラグ（true/false）
QUAKE_ENABLE_SCALE_PROMPT=true       # 震度速報
QUAKE_ENABLE_DESTINATION=true        # 震源に関する情報
QUAKE_ENABLE_SCALE_AND_DEST=true     # 震度・震源に関する情報
QUAKE_ENABLE_DETAIL_SCALE=true       # 各地の震度に関する情報
QUAKE_ENABLE_FOREIGN=true            # 遠地地震に関する情報
QUAKE_ENABLE_OTHER=true              # その他の地震情報

# 津波情報通知の有効化
# デフォルト: true
TSUNAMI_ENABLE=true

# 長周期地震動通知の有効化
# デフォルト: true
ENABLE_LONG_PERIOD=true

# 気象庁その他情報（後発地震注意情報・南海トラフ臨時情報等）の有効化
# デフォルト: true
ENABLE_ADVISORY=true

# 津波観測情報通知の有効化
# デフォルト: true
ENABLE_TSUNAMI_OBS=true


# ------------------------------------------------------------
# ■ 6. EWS（緊急警報放送）信号音
# ------------------------------------------------------------
# 津波警報・大津波警報（津波注意報・津波予報は対象外）が発表・更新された際に、
# 昭和60年郵政省告示第405号準拠のAFSK緊急警報信号音を鳴らす機能。
# 外部WAVファイルへの出力は行わず、メモリ上で生成したPCMをそのまま再生する。
# デフォルト: false（オプトイン。有効にする場合のみ true に設定）
EWS_ENABLE=false

# 告示別表第1号の地域符号キー（例: 全国共通, 東京都, 熊本県 等）。
# core/ews_signal.py の REGION_CODES に無いキーは「全国共通」にフォールバック。
# デフォルト: 全国共通
EWS_REGION=全国共通

# 信号送信ブロック数（1ブロック=58bit、約0.9秒）。大きいほど信号音が長くなる。
# デフォルト: 6
EWS_BLOCKS=6

# 前置・後置固定音（1024Hz単一正弦波）の長さ（秒）
# デフォルト: 0.2 / 0.2
EWS_PRETONE_SEC=0.2
EWS_POSTTONE_SEC=0.2


# ------------------------------------------------------------
# ■ 7. USGS 海外地震情報設定
# ------------------------------------------------------------

# USGS地震通知機能の有効化
# デフォルト: true
USGS_ENABLED=true

# 通知対象のマグニチュード下限
# デフォルト: 5.0
USGS_MAGNITUDE_MIN=5.0

# ポーリング間隔（秒）
# デフォルト: 600（10分）
USGS_FETCH_INTERVAL=600

# 対象地域の緯度・経度範囲（デフォルトは日本周辺〜アジア太平洋）
USGS_REGION_LAT_MIN=20
USGS_REGION_LAT_MAX=50
USGS_REGION_LON_MIN=120
USGS_REGION_LON_MAX=180

# 通知済みIDの保持時間（秒）。重複通知防止用。
# all_day.geojson（過去24時間分）の収録期間に合わせ86400秒（24時間）を推奨。
# デフォルト: 300 ※短いと再起動直後などに重複通知のリスクがあるため、
# 本番運用では 86400 への変更を強く推奨。
USGS_NOTIFICATION_COOLDOWN=300


# ------------------------------------------------------------
# ■ 8. リソース監視設定
# ------------------------------------------------------------

# リソース監視（CPU・メモリ・ディスク）の有効化
# デフォルト: true
RESOURCE_MONITORING_ENABLED=true

# 監視間隔（秒）
# デフォルト: 3600（1時間）
RESOURCE_CHECK_INTERVAL=3600

# ディスク使用率 WARNING 閾値（%）
# デフォルト: 80
DISK_WARNING_THRESHOLD=80

# ディスク使用率 ERROR 閾値（%）
# デフォルト: 90
DISK_ERROR_THRESHOLD=90


# ------------------------------------------------------------
# ■ 9. 強震モニタ画像解析（Kyoshin）設定
#    feature/kyoshin-image-detector ブランチの機能。
#    HSVマスク処理 → グリッド分割 → クラスタリング → 複数フレーム検証
#    の4段階パイプラインで、数値APIを使わず画像のみから揺れを検知する。
#
#    画像取得元: https://www.lmoni.bosai.go.jp/img_svr/data/map_img/RealTimeImg/jma_s/...
#    （防災科研リアルタイム震度モニタの公開画像。系統はjma_sのみ使用。
#    2026-08-19: 配信元を smi.lmoniexp.bosai.go.jp から変更）
#
#    画像の時刻決定には、まず latest.json API
#    (https://smi.lmoniexp.bosai.go.jp/webservice/server/pros/latest.json)
#    から実際に配信されている最新時刻(latest_time)を取得し、それに基づいて
#    画像URLを構築する。取得に失敗した場合のみ、下記のIMAGE_DELAY_SEC等を
#    使った「現在時刻から遡って探索する」従来方式にフォールバックする。
#
#    ⚠ 誤検知対策のアルゴリズム調整値6個は .env.kyoshin.example に
#    分離されています（本ファイルには含まれません。通常運用では不要）。
# ------------------------------------------------------------

# 強震モニタ画像解析機能そのものの有効化。
# Pillow(PIL)が未インストールの場合は自動的にスキップされる。
# デフォルト: true
ENABLE_KYOSHIN=true

# --- グリッド分割・画像取得（latest.json失敗時のフォールバック用） ---

# NIED側の配信遅延を見込んで、現在時刻から何秒遡って画像を探すか。
# latest.json取得に失敗した場合のフォールバック探索でのみ使用される。
# デフォルト: 6（秒）
KYOSHIN_IMAGE_DELAY_SEC=6

# 画像が見つからない場合、さらに遡るステップ幅。
# デフォルト: 3（秒）
KYOSHIN_IMAGE_STEP_SEC=3

# 画像検索の最大リトライ回数（KYOSHIN_IMAGE_DELAY_SEC + STEP*n 秒まで遡る）
# デフォルト: 4（回）
KYOSHIN_IMAGE_MAX_RETRY=4

# --- ポーリング・通知間隔 ---

# 観測値取り込み〜イベント判定(tick)のポーリング間隔。
# 短くすると検知の即応性が上がるが、NIEDサーバーへの負荷とCPU使用率も増える。
# デフォルト: 2.0（秒）
KYOSHIN_POLL_INTERVAL_SEC=2.0

# 揺れ検知イベント継続中、Discordへ画像を再送する間隔。
# EEW発表時の振動モニタ通知(cogs/quake.py側)と間隔を統一するため2.0に変更。
# デフォルト: 2.0（秒）
KYOSHIN_NOTIFY_INTERVAL_SEC=2.0

# --- アルゴリズム調整値（誤検知対策） ---
#
# 【2026-08-27 分離】KYOSHIN_ACTIVE_SHINDO_FLOOR・KYOSHIN_RISE_THRESHOLD・
# KYOSHIN_BASELINE_WINDOW_START_SEC・KYOSHIN_BASELINE_WINDOW_END_SEC・
# KYOSHIN_HISTORY_WINDOW_SEC・KYOSHIN_NEIGHBOR_TRIGGER_COUNT の6個は、
# 実機ログを見ながらチューニングする上級者向けパラメータのため、
# .env.kyoshin.example（コピーして .env.kyoshin として使う）に分離した。
# 何も設定しなくても、そちらに書かれているのと同じデフォルト値で
# 動作する（.env整理案③・⑩）。

# --- 実観測点データソース（2026-08〜。画像ピクセルグリッド方式から移行） ---

# ingen084氏の kyoshin-monitor-observation-points リポジトリが配布する
# 観測点データ(intensity-points.json)の取得元URL。
# 参考実装: https://github.com/akethimitsuhide/kyoshin-monitor-python
# （フォーク元: https://github.com/t0729/kyoshin-monitor-python）
# 通常変更不要。
KYOSHIN_STATIONS_SOURCE_URL=https://raw.githubusercontent.com/ingen084/kyoshin-monitor-observation-points/refs/heads/master/intensity-points.json

# 観測点データのキャッシュファイルパス（相対パスの場合、bot.pyと同じ
# ディレクトリ基準）。*.json は .gitignore 対象のためコミットされない。
# デフォルト: kyoshin_stations_cache.json
KYOSHIN_STATIONS_CACHE_PATH=kyoshin_stations_cache.json

# 観測点データの再取得間隔（秒）。起動時はキャッシュが新しければ
# キャッシュを使い、古い/存在しない場合はここで取得しなおす。
# 以後この間隔でバックグラウンド再取得する。
# 観測点データは「やや古い」ことがある前提のため、定期的に追従する。
# デフォルト: 3600（1時間）
KYOSHIN_STATIONS_REFRESH_SEC=3600

# 近隣観測点として扱う件数（K近傍方式）。実観測点は分布密度が地域
# によって大きく異なる（都市部は密、山間部・離島は疎）ため、
# 固定半径ではなく件数固定のK近傍方式を採用している。
# KYOSHIN_NEIGHBOR_TRIGGER_COUNT（近隣のうち何件が同時上昇したら
# 確定とみなすか）より大きい値にすること。
# デフォルト: 6（点）
KYOSHIN_NEIGHBOR_K=6

# イベントの生死を決めるたった1つの値。イベントに属するいずれかの
# 観測点で最後に「本物の上昇トリガー」が立ってから、この秒数が
# 経過したら、震度の絶対値に関わらずイベントを終了する。
# 値を大きくすると「揺れが収まったと判定するまでの猶予」が長くなる
# （誤って早期に打ち切るリスクは下がるが、本当に収まった後も通知が
# 続く時間は長くなる）。
# デフォルト: 60.0（秒）
KYOSHIN_EVENT_TIMEOUT_SEC=60.0

# --- 通知条件 ---

# 通知を送信する最小フェーズ（定性的な強さの下限）。
# 強さの順序: Weaker < Weak < Medium < Strong < Stronger
# 例えば Medium を指定すると、Weaker/Weak 相当の弱い揺れは検知するが
# Discord通知は送らない（誤検知抑制・通知過多防止）。
# デフォルト: Weaker（全フェーズ通知）
KYOSHIN_MIN_NOTIFY_PHASE=Weaker

# 通知を送るために必要な最小の検出観測点（グリッドセル）数を、
# 実震度によって切り替える（震度が低いほど誤検知の可能性が高いため、
# より多くの観測点での同時検出を要求する）。

# 実震度が1.0未満（震度0相当）の場合に必要な最小観測点数。
# デフォルト: 4（件）
KYOSHIN_MIN_STATIONS_SHINDO0=4

# 実震度が1.0以上（震度1相当以上）の場合に必要な最小観測点数。
# デフォルト: 2（件）
KYOSHIN_MIN_STATIONS_SHINDO1=2

# --- デバッグ用 ---

# confirmed判定が出たフレームの元画像をローカルに一時保存するか。
# 誤検知の事後検証用。常時有効にするとディスクを圧迫するため、
# 通常運用では false を推奨。ラズパイのSDカード容量に注意。
# デフォルト: false
KYOSHIN_DEBUG_SAVE_IMAGE=false

# デバッグ画像の保存先ディレクトリ（KYOSHIN_DEBUG_SAVE_IMAGE=true の場合のみ使用）
# デフォルト: ./kyoshin_debug_images
KYOSHIN_DEBUG_IMAGE_DIR=./kyoshin_debug_images

# 強震モニタのポーリング処理（画像ダウンロード・デコード・観測点
# サンプリング）のうち、デコード+サンプリング部分の所要時間がこの秒数を
# 超えた場合にWARNINGログを出す閾値。通常運用では毎回DEBUGログに
# 所要時間が出るのみだが、閾値超過時はWARNINGでも気づけるようにする。
# Raspberry Pi等の低スペック環境でCPU負荷が問題になっていないかを
# 実測ベースで把握するための設定であり、通常は変更不要。
# デフォルト: 0.5（秒）
KYOSHIN_SLOW_FETCH_THRESHOLD_SEC=0.5

# 【2026-09-09 追加】画像デコード失敗ログの集約間隔（秒）。1秒間隔
# ポーリングでは、配信元の画像が生成途中のタイミングで捕まり一時的に
# デコードへ失敗することが想定内の頻度で起こりうる。毎回WARNINGを
# 出すとログノイズになるため、この秒数ごとに件数をまとめて1回だけ
# WARNINGを出す（詳細は毎回DEBUGに出る）。
# デフォルト: 300（秒、5分）
KYOSHIN_DECODE_FAILURE_LOG_INTERVAL_SEC=300


# ------------------------------------------------------------
# ■ 10. 音声設定（AquesTalkPi / ScratchTTS）
# ------------------------------------------------------------

# 読み上げエンジンの選択
#   aquestalk  : ローカルの AquesTalkPi バイナリを使用（デフォルト）
#   scratchtts : Scratch の音声合成APIをネットワーク経由で使用
#                （利用にはインターネット接続と ffmpeg が必要）
TTS_ENGINE=aquestalk

# --- AquesTalkPi 設定（TTS_ENGINE=aquestalk の場合） ---

# AquesTalkPi の実行ファイルパス。未設定（空）の場合は音声読み上げ機能が無効になる。
# ディレクトリを指定した場合、末尾に /AquesTalkPi を自動補完する。
AQUESTALK_PATH=

# 読み上げ速度
# デフォルト: 150
AQUESTALK_SPEED=150

# --- ScratchTTS 設定（TTS_ENGINE=scratchtts の場合） ---

# ScratchTTS APIのエンドポイント（通常は変更不要）
# デフォルト: https://synthesis-service.scratch.mit.edu/synth
SCRATCHTTS_URL=https://synthesis-service.scratch.mit.edu/synth

# 読み上げ言語ロケール
# デフォルト: ja-JP
SCRATCHTTS_LOCALE=ja-JP

# 音声の性別（female / male）
# デフォルト: female
SCRATCHTTS_GENDER=female

# APIリクエストのタイムアウト秒数
# デフォルト: 10
SCRATCHTTS_TIMEOUT_SEC=10

# 注: ScratchTTS選択時、取得した音声は自動的に約3セミトーン
# （周波数比 約1.19倍）ピッチアップして再生されます（再生時間は変わりません）。
# ピッチシフトには ffmpeg が必要です（Raspberry Pi OSでは
# `sudo apt install ffmpeg` でインストールできます）。
# 入力音声のサンプルレート取得はPython標準ライブラリの wave モジュール
# のみで完結し、外部コマンド（ffprobe等）には依存しません。
# ScratchTTSのレスポンスがWAV形式でない場合はピッチシフト自体を行わず、
# 元音声のまま再生されます。

# ffmpeg の実行コマンド（またはフルパス）
# デフォルトはコマンド名のみで、OSのPATHから解決される。
# PATHが通っていない・別名でインストールされている等の環境でのみ
# 絶対パスを指定する（例: /usr/local/bin/ffmpeg）
# デフォルト: ffmpeg
FFMPEG_PATH=ffmpeg

# --- 共通設定 ---

# 音声再生コマンド
# デフォルト: aplay
AUDIO_PLAYER=aplay


# ------------------------------------------------------------
# ■ 11. EEW・API 挙動設定
# ------------------------------------------------------------

# Wolfx WebSocket heartbeat タイムアウト（秒）。
# デフォルト: 90
WOLFX_HEARTBEAT_TIMEOUT=90

# API連続失敗でバックオフに入るまでの回数
# デフォルト: 3
FETCH_FAILURE_THRESHOLD=3

# API失敗時のバックオフ待機時間（秒）
# デフォルト: 60
FETCH_BACKOFF_SECONDS=60


# ------------------------------------------------------------
# ■ 12. キュー設定（メモリ枯渇対策）
# ------------------------------------------------------------

# 音声読み上げキューの最大サイズ
# デフォルト: 200
SPEECH_QUEUE_MAXSIZE=200

# MP3再生キューの最大サイズ
# デフォルト: 50
MP3_QUEUE_MAXSIZE=50


# ------------------------------------------------------------
# ■ 13. !status / /qtl_status 表示設定
# ------------------------------------------------------------

STATUS_SHOW_CPU=true       # CPU使用率を表示
STATUS_SHOW_MEM=true       # メモリ使用量を表示
STATUS_SHOW_DISK=true      # ディスク使用率を表示
STATUS_SHOW_UPTIME=true    # フィルター設定・稼働時間を表示


# ------------------------------------------------------------
# ■ 14. Mackerel APM（トレーシング）連携設定
#    OpenTelemetry (OTLP) 経由で Mackerel にトレースを送信する。
#    有効化する場合、requirements.txt の APM(Mackerel連携)
#    セクションのパッケージのインストールが必要。
# ------------------------------------------------------------

# APM連携の有効化。
# デフォルト: false（無効。有効にする場合は明示的に true を指定）
APM_ENABLED=false

# Mackerel上でのサービス名（トレースの識別に使用）
# デフォルト: QTL_Bot
APM_SERVICE_NAME=QTL_Bot

# Mackerel APIキー（Mackerelの「サービス」に紐づくAPIキーを指定）
# 機密情報のため、他人と共有するリポジトリには絶対にコミットしないこと。
APM_MACKEREL_API_KEY=

# OTLP送信先エンドポイント。
# 末尾は必ず /v1/traces にすること（core/apm.py 側でパスを追加結合しない）。
# デフォルト: https://otlp-vaxila.mackerelio.com/v1/traces
APM_OTLP_ENDPOINT=https://otlp-vaxila.mackerelio.com/v1/traces

# OTLP送信時のAPIキーヘッダー名
# デフォルト: Mackerel-Api-Key
APM_OTLP_API_KEY_HEADER=Mackerel-Api-Key

# ------------------------------------------------------------
# ■ 15. Web Dashboard 設定
#    ⚠️ 注意: 他の変数と異なり、core/config.py ではなく
#    cogs/system.py が直接 os.getenv() で読み込んでいる。
#    将来的に config.py へ集約するとメンテナンス性が向上する。
# ------------------------------------------------------------

# Web Dashboard の有効化
# デフォルト: false
WEB_DASHBOARD_ENABLED=false

# Web Dashboard が listen するポート
# デフォルト: 8080
WEB_DASHBOARD_PORT=8080

# Web Dashboard がバインドするアドレス
# デフォルト: 127.0.0.1（このマシンからのみアクセス可能。外部公開されない）
# LAN内の他端末からも見たい場合は 0.0.0.0 を指定する
# （その場合、WEB_DASHBOARD_ALLOWED_IPS の設定を強く推奨）
WEB_DASHBOARD_HOST=127.0.0.1

# Web Dashboard へのアクセスを許可するクライアントIPのカンマ区切りリスト
# 例: WEB_DASHBOARD_ALLOWED_IPS=192.168.1.10,192.168.1.20
# CIDR表記も可: WEB_DASHBOARD_ALLOWED_IPS=192.168.1.0/24
# 空（デフォルト）の場合はIP制限を行わない
# （WEB_DASHBOARD_HOSTのバインド範囲のみで制御される）
WEB_DASHBOARD_ALLOWED_IPS=

# --- グラフ・履歴表示（GET /dashboard, GET /status/history） ---
# システムリソース（CPU/メモリ/ディスク使用率）・各種受信件数の推移を
# 定期的にメモリ上のリングバッファへ記録し、GET /dashboard のグラフ
# ページ（Chart.js使用）・GET /status/history のJSON APIで参照できる。
# 記録データはBot再起動でリセットされる（外部DB等は使用しない）。

# スナップショットの記録間隔（秒）
# デフォルト: 300（5分）
STATUS_HISTORY_INTERVAL=300

# 保持するスナップショットの最大件数（古いものから自動的に破棄される）
# デフォルト: 288（300秒間隔の場合、24時間分に相当）
STATUS_HISTORY_MAXLEN=288

# ------------------------------------------------------------
# ■ 16. P2P 地図画像設定
#    【2026-08-27 分離】以前は「Web Dashboard 設定」セクションに
#    含まれていたが、Web Dashboardとは無関係な機能のため独立
#    セクションに分離した（.env整理案②）。
# ------------------------------------------------------------

# P2P 地震情報の地図画像を Embed に添付するか。
# false にすると CDN ポーリング処理自体を無効化し、通知本文に画像URLを
# テキストとして含める簡易方式（Discordのリンクプレビューで自動展開）に
# フォールバックする（原因切り分け用）。
# デフォルト: true
P2P_IMAGE_ATTACH_ENABLED=true

# P2P地震情報CDN（cdn.p2pquake.net）への同時アクセス数の上限。
# 大規模地震で短時間に複数のP2P地震情報レポート（震度速報→各地の
# 震度に関する情報等）が連続発表されると、それぞれが独立した画像
# 添付タスクとして並行実行され、同一CDNへの同時多発リクエストにより
# 成功率が大幅に低下する不具合が確認されたため追加した
# （2026-08-23、実際の震度5弱の地震で5件中3件が失敗した事例あり）。
# 値を上げるほど同時実行の並列度は上がるが、CDN側の負荷・レート
# 制限に引っかかるリスクも上がる。
# デフォルト: 3
P2P_IMAGE_CDN_CONCURRENCY=3

# ------------------------------------------------------------
# ■ 16a. 地震情報 履歴（qtlbot.logベース、地図・表での閲覧機能）
#    【2026-09-06 追加】core/quake_history_log.py 参照。地震情報
#    （P2P地震情報 code=551）の通知内容を、qtlbot.log（ローテーション
#    含む）へ機械可読な形で記録し、Web Dashboardの /quake_map
#    （地図・表）・/status/quake_history（JSON）で閲覧できるようにする
#    機能の設定。
# ------------------------------------------------------------

# /status/quake_history がデフォルトで返す最大件数
# （クエリパラメータ ?limit= で上書き可能）。
# デフォルト: 500
QUAKE_HISTORY_DEFAULT_LIMIT=500

# qtlbot.log*（ローテーション込み）のスキャン結果をキャッシュする秒数。
# ファイルサイズ次第でスキャンに時間がかかりうるため、Web Dashboardへの
# 連続アクセスで毎回スキャンし直すことを避ける。
# デフォルト: 30（秒）
QUAKE_HISTORY_CACHE_TTL_SEC=30

# --backfill_quake_history（core/quake_history_backfill.py）専用設定。
# この記録形式を追加する前に発生した地震について、P2P地震情報 API
# から可能な範囲で遡って取得し、qtlbot.logへ書き足す一括バックフィル
# コマンド（`python3 bot.py --backfill_quake_history`）で使う。
# P2P地震情報 API の /v2/history は無制限に過去へ遡れるAPIではないため、
# 際限なくページングし続けないための安全な上限として使う。
# デフォルト: 1000（件）
QUAKE_HISTORY_BACKFILL_MAX_ITEMS=1000
# 1回のAPIリクエストで取得する件数。
# デフォルト: 100
QUAKE_HISTORY_BACKFILL_PAGE_SIZE=100
# ページ取得ごとの待機秒数（API・回線への配慮）。
# デフォルト: 0.5（秒）
QUAKE_HISTORY_BACKFILL_REQUEST_DELAY_SEC=0.5

# ------------------------------------------------------------
# ■ 17. P2P 地震感知情報設定（2026-08〜）
#    【2026-08-27 分離】以前は「Web Dashboard 設定」セクションに
#    含まれていたが、Web Dashboardとは無関係な機能のため独立
#    セクションに分離した（.env整理案②）。
#    通知先チャンネルは JISHIN_KANCHI_CHANNEL_ID（セクション2参照）。
# ------------------------------------------------------------

# 地震感知情報（code=9611）は気象庁の公式発表ではなく、P2P地震情報が
# 独自に推定する非公式な速報値。信頼度が低い場合は誤報の可能性がある
# ため、デフォルトでは無効。
# デフォルト: false
JISHIN_KANCHI_ENABLE=false

# 通知する最大レベル（1〜4、数値が大きいほど信頼度が低い）。
# この値以下のレベルのみ通知する。例: 2を指定するとレベル1・2のみ
# 通知し、レベル3・4（信頼度が低い）は抑制する。
# デフォルト: 4（全レベル通知）
JISHIN_KANCHI_MAX_LEVEL=4

# 通知する最小件数（count）。これ未満の件数は通知しない。
# デフォルト: 1
JISHIN_KANCHI_MIN_COUNT=1

# 音声読み上げ・効果音再生の有効化
# デフォルト: true
JISHIN_KANCHI_SPEECH_ENABLE=true
JISHIN_KANCHI_SOUND_ENABLE=true

# 再生する効果音ファイル名（Bot実行ディレクトリ直下に配置）。
# デフォルトは既存のvxse53.mp3を流用する（専用音源が用意できるまでの暫定値）。
JISHIN_KANCHI_SOUND_FILE=vxse53.mp3

# 【2026-08-23追加、2026-08-27仕様変更】音声読み上げ・効果音とも、
# 同一イベント（started_atで識別。EEWのEventIDに相当）について
# 「そのイベントを初めて検知したとき（＝第一報）」の1回のみ再生する。
# 更新のたびに毎回鳴らすとうるさいための間引き対策（詳細はREADME
# 「P2P 地震感知情報」セクション参照）。
JISHIN_KANCHI_EVENT_STATE_TTL_SEC=3600

# 【2026-08-30追加】同一イベントのテキスト通知（Embed送信）を実際に
# 行う最短間隔（秒）。第一報は必ず送信するが、2回目以降の更新は、
# 前回実際に送信してからこの秒数未満しか経っていない場合は送信自体を
# スキップする。地図画像添付タスクは既に第一報のみに間引かれているが
# （上記参照）、テキスト通知自体はこれとは独立して毎回送信され続ける
# 設計だったため、感知報告が短時間に大量発生する地震（大規模・関東等）
# でチャンネルが同種メッセージで埋まる実害への対策として追加した。
# 値を大きくするほど更新頻度は下がる。0以下を指定すると事実上無効化
# （毎回送信）になる。
# デフォルト: 10（秒）
JISHIN_KANCHI_MIN_UPDATE_INTERVAL_SEC=10

# ------------------------------------------------------------
# ■ 18. 週間/月間ダイジェスト設定（2026-08〜）
#    【2026-08-27 分離】以前は「Web Dashboard 設定」セクションに
#    含まれていたが、Web Dashboardとは無関係な機能のため独立
#    セクションに分離した（.env整理案②）。
# ------------------------------------------------------------

# 定期的に「先週/先月の地震活動まとめ」Embedを自動投稿する機能。
# デフォルト: false
DIGEST_ENABLED=false

# "weekly"（毎週） または "monthly"（毎月1日）
# デフォルト: weekly
DIGEST_INTERVAL=weekly

# weekly時のみ使用。投稿曜日（0=月曜, 1=火曜, ... 6=日曜）
# デフォルト: 0（月曜）
DIGEST_WEEKDAY=0

# 投稿時刻（24時間制、0〜23）。monthly時は毎月1日のこの時刻に投稿する
# デフォルト: 9
DIGEST_HOUR=9

# ダイジェスト投稿先チャンネル。未設定時は CHANNEL_ID を使用する。
DIGEST_CHANNEL_ID=
